taskENTER_CRITICAL(&meuSpinlock);
// Simulando a lentidão do barramento I2C bloqueando a CPU fisicamente
esp_rom_delay_us(5000);
taskEXIT_CRITICAL(&meuSpinlock);
vTaskDelay(pdMS_TO_TICKS(100)); // Aguarda fora da trava para nova leitura
