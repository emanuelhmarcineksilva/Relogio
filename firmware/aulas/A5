5. Exercício 1 — O "Blink Matemático"
(Impacto das Flags de Compilação)
Objetivo: Visualizar fisicamente (pelo LED) e numericamente (pelo Serial Monitor) o
impacto das flags -O0, -O2 e -O3 do GCC no tempo de processamento.
Código para testar:
// *** ALTERE ESTA LINHA ENTRE "O0", "O2" e "O3" ***
#pragma GCC optimize ("O0")
const int LED_PIN = 2;
volatile float calculo_inutil = 0;void setup() {
pinMode(LED_PIN, OUTPUT);
Serial.begin(115200);
}
void loop() {
unsigned long t1 = micros();
for (long i = 0; i < 1000000000; i++) {
calculo_inutil += 0.01f;
}
unsigned long t2 = micros();
digitalWrite(LED_PIN, !digitalRead(LED_PIN));
Serial.print("Latência de processamento (us): ");
Serial.println(t2 - t1);
}
