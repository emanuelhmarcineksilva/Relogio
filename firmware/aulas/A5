12. Exercício 5 — DVFS: Clock Alto vs
Clock Baixo
Objetivo: Comparar o tempo de execução de uma tarefa computacional rodando a
240 MHz versus 80 MHz, e discutir o compromisso energia × tempo.
Código para testar:// Arduino Core para ESP32 já disponibiliza setCpuFrequencyMhz() e
getCpuFrequencyMhz()
// Não é necessário incluir headers adicionais do ESP-IDF
volatile float resultado = 0;
void executarCarga() {
unsigned long t1 = micros();
for (long i = 0; i < 1000000000; i++) {
resultado += 0.01f;
}
unsigned long t2 = micros();
Serial.printf("Tempo de processamento: %lu us (CPU: %d MHz)\n", t2 - t1,
getCpuFrequencyMhz());
}
void setup() {
Serial.begin(115200);
delay(1000);
// Teste 1: Clock máximo (240 MHz)
setCpuFrequencyMhz(240);
Serial.println("--- Teste a 240 MHz ---");
executarCarga();
delay(500);
// Teste 2: Clock reduzido (80 MHz)
setCpuFrequencyMhz(80);
Serial.println("--- Teste a 80 MHz ---");
executarCarga();
// Restaurar
setCpuFrequencyMhz(240);
}
void loop() {}
