6. Atividade 3 — Dual Core “de
verdade”: aquisição em um core,
renderização no outro
Objetivo: aplicar separação de responsabilidades:
Core 0 (Produtor): aquisição e pré-processamento (média móvel, normalização).
Core 1 (Consumidor): renderização TFT + logs.
6.0 Conceitos (relembrando)
Task: uma “função que roda em paralelo” (pense em uma thread). No ESP32,
você cria tasks com xTaskCreatePinnedToCore(...).
Core: o ESP32 tem 2 núcleos. Ao “pinhar” uma task, você escolhe em qual core
ela roda.Queue: uma fila do FreeRTOS para passar dados do Produtor para o
Consumidor com segurança (sem condição de corrida).
Se você vier de Python: imagine que o Produtor faz leituras e coloca em uma
queue.Queue(), e o Consumidor fica lendo e desenhando na tela.
6.1 Regras do experimento
O Produtor não pode fazer Serial.print() nem acessar o TFT.
O Consumidor não pode chamar analogRead().
Comunicação deve ser via:
Queue (recomendado para didática) ou
struct compartilhada + mutex (alternativa)
6.1.1 Estrutura de dados sugerida (para a
Queue)
Use uma struct simples para enviar um “pacote” com as leituras normalizadas:
struct Sample {
uint16_t pot1;
uint16_t pot2;
uint16_t ldr;
uint16_t temp;
uint32_t seq;
};
// 0–100
// 0–100
// 0–100
// 0–100
// contador de amostras (incrementa)
No Produtor: preenche e envia com xQueueOverwrite (se você quer sempre o último
valor) ou xQueueSend (se você quer enfileirar tudo).
No Consumidor: recebe e atualiza o TFT.
6.2 Métrica
No Produtor:
Meça dt_us entre amostras (esp_timer_get_time()).
Imprima (no Consumidor) a cada 1 s:
amostras/s e jitter_pp do ProdutorPergunta: o jitter do Produtor muda quando a atualização do TFT fica mais “pesada”
(ex.: redesenhar tudo)?
Exemplo base completo (Dual-Core + Queue +
TFT)
Este exemplo é um “esqueleto funcional”: Produtor lê sensores e envia,
Consumidor desenha no TFT (sem flicker).
Ajuste apenas os pinos dos sensores (PIN_*). O TFT e os botões seguem o
padrão ES32Lab.
#include <Arduino.h>
#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h>
#include "esp_timer.h"
// ===== TFT (padrão ES32Lab) =====
static constexpr int TFT_CS = 15;
static constexpr int TFT_DC = 2;
static constexpr int TFT_RST = -1;
Adafruit_ST7735 tft = Adafruit_ST7735(TFT_CS, TFT_DC, TFT_RST);
// ===== Sensores (ajuste) =====
static constexpr int PIN_POT1 = 32;
static constexpr int PIN_POT2 = 34;
static constexpr int PIN_LDR = 35;
static constexpr int PIN_TEMP = 36;
static int toPercent(int raw) {
return constrain(map(raw, 0, 4095, 0, 100), 0, 100);
}
struct Sample {
uint16_t pot1, pot2, ldr, temp; // 0–100
uint32_t seq;
int64_t t_us;
// timestamp do produtor (para métricas)
};
static QueueHandle_t q = nullptr;
static volatile uint32_t prodCount = 0;
// ===== Layout simples (sem flicker) =====
static constexpr int X_LABEL = 5;
static constexpr int X_VALUE = 70;
static constexpr int W_VALUE = 80;
static constexpr int H_VALUE = 12;
static constexpr int Y_POT1 = 10, Y_POT2 = 25, Y_LDR = 40, Y_TEMP = 55;
static void drawStaticLabels() {tft.fillScreen(ST77XX_BLACK);
tft.setTextSize(1);
tft.setTextColor(ST77XX_WHITE);
tft.setCursor(X_LABEL, Y_POT1); tft.print("POT1:");
tft.setCursor(X_LABEL, Y_POT2); tft.print("POT2:");
tft.setCursor(X_LABEL, Y_LDR ); tft.print("LDR :");
tft.setCursor(X_LABEL, Y_TEMP); tft.print("TEMP:");
}
static void drawPercentValue(int y, int percent) {
percent = constrain(percent, 0, 100);
tft.fillRect(X_VALUE, y, W_VALUE, H_VALUE, ST77XX_BLACK);
tft.setCursor(X_VALUE, y);
tft.setTextColor(ST77XX_WHITE, ST77XX_BLACK);
tft.printf("%3d%%", percent);
}
void producerTask(void*) {
Sample s{};
while (true) {
s.pot1 = toPercent(analogRead(PIN_POT1));
s.pot2 = toPercent(analogRead(PIN_POT2));
s.ldr = toPercent(analogRead(PIN_LDR));
s.temp = toPercent(analogRead(PIN_TEMP));
s.seq++;
s.t_us = esp_timer_get_time();
// Fila de 1 elemento: sempre mantém o último valor (ótimo para dashboard)
xQueueOverwrite(q, &s);
prodCount++;
}
}
void consumerTask(void*) {
Sample s{};
uint32_t lastProdCount = 0;
int64_t lastPrintUs = esp_timer_get_time();
while (true) {
if (xQueueReceive(q, &s, portMAX_DELAY) == pdTRUE) {
drawPercentValue(Y_POT1, s.pot1);
drawPercentValue(Y_POT2, s.pot2);
drawPercentValue(Y_LDR, s.ldr);
drawPercentValue(Y_TEMP, s.temp);
}
// Log 1x/s (no consumidor)
int64_t now = esp_timer_get_time();
if (now - lastPrintUs >= 1000000) {
uint32_t pc = prodCount;
Serial.printf("prod_rate=%.0f/s last_seq=%u\n",
(pc - lastProdCount) / ((now - lastPrintUs) / 1e6f),
(unsigned)s.seq);
lastProdCount = pc;
lastPrintUs = now;
}
}}
void setup() {
Serial.begin(115200);
delay(300);
