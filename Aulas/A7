bool heavyRender = false;
int adcVal;
Btn b = readButton(adcVal);
if (b == BTN_SELECT) heavyRender = !heavyRender; // toggle
if (heavyRender) {
tft.fillScreen(ST77XX_BLACK); // PESADO
